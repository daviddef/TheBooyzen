---
import "@daviddef/archive-kit/styles/print.css";
import { versioner } from "@daviddef/archive-kit/lib/assetv.js";
/* every public asset gets a fingerprint, so a fix is never served stale */
const v = versioner();
import { u } from "../lib/url.js";
import SiblingArchives from "@daviddef/archive-kit/components/SiblingArchives.astro";
import SkipLink from "@daviddef/archive-kit/components/SkipLink.astro";
import SocialHead from "@daviddef/archive-kit/components/SocialHead.astro";
import JsonLd from "@daviddef/archive-kit/components/JsonLd.astro";
import VisitCount from "@daviddef/archive-kit/components/VisitCount.astro";
import ring from "@daviddef/archive-kit/data/archives.json";
const { title, description = "", dek, eyebrow, bare, noindex } = Astro.props;
const SITE = "The Booyzen Archive";
const nav = [
  ["Start", [["/", "Home"], ["/about/", "About"], ["/trees/", "The trees"], ["/tree/", "Our line, drawn"], ["/atlas/", "The Atlas"], ["/timeline/", "The Timeline"]]],
  ["Our line", [["/direct-line/", "The Spine"], ["/rebels/", "The Rebels"], ["/johannesburg/", "Johannesburg"], ["/name/", "The Name"]]],
  ["The families", [["/barry/", "The Barrys"], ["/kolbe/", "The Kolbes"], ["/women/", "The Women"], ["/cousins/", "The Cousin Marriage"]]],
  ["People & places", [["/people/", "The People"], ["/who/", "Every Name"], ["/bloodline/", "Blood relatives, drawn"], ["/register/", "The Register"], ["/households/", "Households"], ["/marriages/", "The Marriages"], ["/places/", "Places"], ["/namesakes/", "The forenames"]]],
  ["Evidence", [["/dna/", "The DNA"], ["/disputed/", "Disputed"], ["/errands/", "Errands"], ["/sources/", "Sources"], ["/searched/", "What Has Been Read"], ["/worklist/", "The work list"], ["/letters/", "The Letters"], ["/open-questions/", "Open Questions"], ["/corrections/", "Corrections"], ["/changes/", "What changed"], ["/research-log/", "Research Log"], ["/method/", "Method"], ["/documents/", "Documents"], ["/gallery/", "Gallery"]]],
];

const here = Astro.url.pathname;
/* which of the seven this is, worked out the same way the ring does */
const thisArchive = ring.archives.find(
  (a) => a.base === (import.meta.env.BASE_URL || "/").replace(/\/$/, "")
);
---
<html lang="en" data-base={u("")}>
<head>
<meta charset="utf-8" />
<meta name="viewport" content="width=device-width,initial-scale=1" />
<title>{title === SITE ? SITE : `${title} — ${SITE}`}</title>
<meta name="description" content={dek ?? "An evidence-first archive of the Booyzen family — the north-eastern Cape, the Anglo-Boer War, and Johannesburg."} />
<SocialHead title={title} description={dek || description} site={SITE} />
<JsonLd type={bare ? "WebSite" : "Article"} name={title} description={dek || description}
        url={Astro.site ? new URL(Astro.url.pathname, Astro.site).href : Astro.url.pathname}
        site={SITE} about={Astro.props.person} />
    {noindex && <meta name="robots" content="noindex" />}
<link rel="preconnect" href="https://fonts.googleapis.com" />
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=EB+Garamond:ital,wght@0,400;0,500;0,600;1,400&family=Libre+Franklin:wght@400;500;600&family=IBM+Plex+Mono:wght@400;500&display=swap" />
<link rel="stylesheet" href={u("/styles.css") + v("styles.css")} />
</head>
<body class={bare ? "is-home" : ""}>
<SkipLink />
<header class="site">
  <div class="wrap sitein">
    <a class="brand" href={u("/")}>The Booyzen <em>Archive</em></a>
    <button class="burger" type="button" aria-expanded="false" aria-controls="drawer">
      <span class="bars" aria-hidden="true"></span>Menu
    </button>
    <nav class="topnav" aria-label="Main">
      {nav.map(([label, links]) => (
        <details class="menu">
          <summary>{label}</summary>
          <div class="panel">
            {links.map(([h, l]) => <a href={u(h)} class={here === u(h) ? "on" : ""}>{l}</a>)}
          </div>
        </details>
      ))}
      <a class="findbtn" href={u("/search/")} aria-label="Search the archive">Search</a>
    </nav>
  </div>
  <div class="drawer" id="drawer" hidden>
    <div class="wrap">{nav.map(([label, links]) => (
      <div class="dgrp"><span class="gl">{label}</span>
        {links.map(([h, l]) => <a href={u(h)} class={here === u(h) ? "on" : ""}>{l}</a>)}
      </div>
    ))}
    <div class="dgrp"><span class="gl">Find</span>
      <a href={u("/search/")} class={here === u("/search/") ? "on" : ""}>Search the archive</a>
      <a href={u("/people/")}>Everyone</a>
      <a href={u("/register/")}>The register</a>
      <a href={u("/places/")}>The places</a>
    </div></div>
  </div>
</header>

<main id="main" tabindex="-1">
  <div class="wrap">
    {!bare && (
      <div class="pagehead">
        {eyebrow && <div class="lab">{eyebrow}</div>}
        <h1>{title}</h1>
        {dek && <p class="dek lead">{dek}</p>}
      </div>
    )}
    <div id="onthispage" hidden></div>
    <slot />
  </div>
</main>

<footer class="site">
  <div class="wrap">
    <SiblingArchives />
    <p class="foot">An evidence-first family archive for the Booyzen family — of Graaff-Reinet and Cradock,
    of Barkly East and Dordrecht, and of Johannesburg. Every claim carries its confidence. <strong>Living people are named</strong> — name and relationship only, never a date, a place, a photograph or a record. <strong>This archive currently holds none.</strong></p>
    <p class="foot dim">Built {new Date().getFullYear()} ·
      <a href={u("/sources/")}>Sources</a> ·
      <a href={u("/method/")}>Method</a> ·
      <a href={u("/open-questions/")}>Open questions</a> ·
      <a href={u("/corrections/")}>Corrections</a> ·
      Corrections are the most valuable thing you can send</p>
    <VisitCount code={thisArchive?.counter} />
  </div>
</footer>

<script is:inline>
  (function () {
    var bar = document.querySelector(".topnav");
    var burger = document.querySelector(".burger");
    var drawer = document.getElementById("drawer");
    if (burger && drawer) {
      burger.addEventListener("click", function () {
        var open = drawer.hasAttribute("hidden");
        if (open) { drawer.removeAttribute("hidden"); } else { drawer.setAttribute("hidden", ""); }
        burger.setAttribute("aria-expanded", open ? "true" : "false");
      });
    }
    if (!bar) return;
    var menus = [].slice.call(bar.querySelectorAll("details.menu"));
    menus.forEach(function (d) {
      d.addEventListener("toggle", function () {
        if (!d.open) return;
        menus.forEach(function (o) { if (o !== d) o.open = false; });
      });
    });
    document.addEventListener("click", function (e) {
      if (e.target.closest(".topnav")) return;
      menus.forEach(function (d) { d.open = false; });
    });
    document.addEventListener("keydown", function (e) {
      if (e.key === "Escape") menus.forEach(function (d) { d.open = false; });
    });
  })();
</script>
<script is:inline define:vars={{ searchUrl: u("/search/") }}>
  /* "/" opens the search from anywhere, the way an archive catalogue should. */
  document.addEventListener("keydown", function (e) {
    if (e.key !== "/" || e.metaKey || e.ctrlKey || e.altKey) return;
    var t = e.target;
    if (t && (t.tagName === "INPUT" || t.tagName === "TEXTAREA" || t.isContentEditable)) return;
    e.preventDefault();
    location.href = searchUrl;
  });
</script>
<script is:inline>
  /* On a long page, build a jump list from the section headings, in the browser,
     so no page has to declare its own contents. */
  (function () {
    var host = document.getElementById("onthispage");
    if (!host) return;
    var hs = [].slice.call(document.querySelectorAll("main section > h2"));
    if (hs.length < 4) return;
    var sl = function (t) {
      return t.toLowerCase().normalize("NFD").replace(/[\u0300-\u036f]/g, "")
        .replace(/[^a-z0-9]+/g, "-").replace(/^-|-$/g, "").slice(0, 48);
    };
    var seen = {}, items = [];
    hs.forEach(function (h) {
      var t = (h.textContent || "").trim();
      if (!t) return;
      var id = h.id || sl(t) || "s";
      if (seen[id]) id = id + "-" + (++seen[id]); else seen[id] = 1;
      h.id = id; items.push([id, t]);
    });
    if (items.length < 4) return;
    var det = document.createElement("details"); det.className = "toc";
    var sum = document.createElement("summary");
    sum.textContent = "On this page · " + items.length + " sections";
    det.appendChild(sum);
    var nav = document.createElement("nav");
    items.forEach(function (it) {
      var a = document.createElement("a"); a.href = "#" + it[0]; a.textContent = it[1];
      nav.appendChild(a);
    });
    det.appendChild(nav); host.appendChild(det); host.hidden = false;
    var mq = window.matchMedia("(min-width: 901px)");
    det.addEventListener("click", function (ev) {
      if (!mq.matches && ev.target.closest("nav a")) det.open = false;
    });
  })();
</script>
<script src={u("/wholink.js") + v("wholink.js")} defer></script>
</body>
</html>
