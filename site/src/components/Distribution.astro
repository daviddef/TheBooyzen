---
/* Two spellings, one country: where each name actually lives. */
const { rows, unit = "", accent = "--accent", max: maxIn } = Astro.props;
const max = maxIn ?? Math.max(...rows.map(r => r[1]));
const BW = 470, LW = 168, RH = 24;
const H = rows.length * RH + 18;
---
<div class="scroll">
<svg viewBox={`0 0 ${LW + BW + 90} ${H}`} width={LW + BW + 90}
     style="min-width:520px;display:block" role="img">
  {rows.map(([label, n, note], i) => (
    <g>
      <text x={LW - 12} y={i * RH + 17} text-anchor="end" font-size="12.5"
            style="fill:var(--ink-2);font-family:var(--sans)">{label}</text>
      <rect x={LW} y={i * RH + 5} width={Math.max(2, (n / max) * BW)} height={15} rx="1"
            style={`fill:var(${i === 0 ? accent : "--rule-strong"})`} />
      <text x={LW + Math.max(2, (n / max) * BW) + 9} y={i * RH + 17} font-size="11.5"
            style="fill:var(--ink-3);font-family:var(--mono)">{note ?? n.toLocaleString() + unit}</text>
    </g>
  ))}
  <line x1={LW} y1={rows.length * RH + 2} x2={LW + BW} y2={rows.length * RH + 2}
        style="stroke:var(--rule)" stroke-width="1" />
</svg>
</div>
