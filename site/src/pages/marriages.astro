---
import Base from "../layouts/Base.astro";
import Rule from "../components/Rule.astro";
import { u } from "../lib/url.js";
import mg from "../data/marriages.json";
import { resolve, dates, slugify } from "../lib/kin.js";
import Marriages from "@daviddef/archive-kit/components/Marriages.astro";
import P from "../data/people.json";
const rows = mg.rows.map(r => ({ ...r, H: resolve(r.h), W: resolve(r.w) }))
  .sort((a, b) => (a.ds < b.ds ? -1 : 1));
const placed = rows.filter(r => r.p !== "—");
const byPlace = {};
for (const r of placed) (byPlace[r.p] ||= []).push(r);
const places = Object.entries(byPlace).sort((a, b) => b[1].length - a[1].length);
const docCount = rows.filter(r => r.via === "doc").length;

/* The other half of a marriage page: a marriage is where two LINES join, and
   this page could name the marriages without ever naming the lines.
   
   Nothing here is grouped by surname. Every person in people.json already
   carries an `l` — the line this archive has assigned them to — so the grouping
   is the archive's own editorial judgement recorded in the data, not a string
   comparison run at build time. The Booyzen and the Booysen of the same
   household are one line because somebody decided so and wrote it down.
   
   Lines are ordered by the generation at which they first appear, which is the
   same question the rest of the estate asks: how does this family reach this
   one, and when. */
const GEN_LABEL = {
  2: "The second generation", 3: "The third", 4: "The fourth",
  5: "The fifth", 6: "The sixth", 7: "The seventh",
};
const LINE_NOTE = {
  "Booyzen": "The name this archive carries.",
  "Mountjoy": "The hinge. Cradock, 4 November 1838 joins Booysen to Mountjoy.",
  "Lerena": "Where this archive stops and the Lerena one begins — Mayfair, 15 January 1949.",
  "Testimony": "Not a family at all: a single person held here because of what they said, not who they were.",
};
const SRC = { doc: "a record read here", inf: "inferred", open: "an open question", lore: "family tree" };

const byLine = {};
for (const x of P.people) (byLine[x.l] ||= []).push(x);

const lineFam = (name) => {
  const list = (byLine[name] || []).slice()
    .sort((a, b) => (a.g || 99) - (b.g || 99) || a.n.localeCompare(b.n));
  const srcs = list.reduce((m, x) => ((m[x.s] = (m[x.s] || 0) + 1), m), {});
  const marr = rows.filter(r => (r.H && r.H.l === name) || (r.W && r.W.l === name));
  return {
    surname: name,
    n: list.length,
    countLabel: "people",
    span: (() => {
      const g = list.map(x => x.g).filter(Boolean);
      return g.length ? `generation ${Math.min(...g)}\u2013${Math.max(...g)}` : "";
    })(),
    places: [],
    story: LINE_NOTE[name] || "",
    note: `Held on ${Object.entries(srcs).sort((a, b) => b[1] - a[1])
      .map(([k, v]) => `<strong>${v}</strong> ${SRC[k] || k}`).join(" · ")}.`,
    marriages: marr.map(r => ({
      who: r.H ? r.H.n : "—", whoSlug: "", to: r.W ? r.W.n : "—", toSlug: "",
    })),
    people: list.map(x => ({
      name: x.n, slug: "", b: x.b === "\u2014" ? "" : x.b, bp: x.g ? "gen " + x.g : "",
      d: x.d === "\u2014" ? "" : x.d, dp: "",
    })),
  };
};

/* The lines are NOT grouped by generation, and the reason is a finding rather
   than a limitation of the page: only the Booyzen line carries generation
   numbers at all. All 136 of its people are numbered 2 to 7; the other ten
   lines — 190 people between them — carry none. A first attempt grouped by
   generation anyway and quietly dropped every line that had no number, showing
   one family out of eleven on a page that otherwise looked correct.
   
   So the split is the one the data can actually support: the name this archive
   carries, and the lines that married into it. */
const OWN = "Booyzen";
const married = P.lines.filter(n => n !== OWN)
  .sort((a, b) => (byLine[b] || []).length - (byLine[a] || []).length);
const nMarriedPeople = married.reduce((a, n) => a + (byLine[n] || []).length, 0);

const GROUPED = [
  {
    key: "own", label: "The name this archive carries", count: 1,
    blurb: `<strong>${(byLine[OWN] || []).length} people across six generations.</strong> This is the
      only line in the archive that is numbered: every person on it carries a generation, 2 to 7.`,
    families: [lineFam(OWN)],
  },
  {
    key: "in", label: "The lines that married in", count: married.length,
    blurb: `<strong>${married.length} lines, ${nMarriedPeople} people</strong> — more people than the
      name itself holds. <strong>Not one of them carries a generation number.</strong> That is worth
      saying plainly: this archive numbers its own descent and does not number the families that
      joined it, so they cannot be ordered by when they arrived, only by how much of each is held.
      They are ordered by that.`,
    families: married.map(lineFam),
  },
];
---
<Base title="The marriages"
      eyebrow={`${rows.length} marriages · ${placed.length} with a place`}
      dek="Every marriage in this archive that a document places, in order. A marriage is where two lines join — and it is also the moment a family chooses a town, a church and a witness, which is why the column that matters most here is not the date.">

<section class="blk">
  <h2>What the places say</h2>
  <div class="prose">
    <p><b>{docCount} of the {rows.length}</b> rest on a record this archive has read. Read the right-hand
      column down and the family's whole movement is in it: three marriages at
      <b>Graaff-Reinet and Cradock</b> before 1850, then the north-eastern Cape for fifty years &mdash;
      <b>Lady Grey, Dordrecht, Caerlaverock, Indwe</b> &mdash; then, once and finally,
      <b>Vereeniging</b> and <b>Johannesburg</b>.</p>
    <blockquote>Two of them are the hinges of this archive. <b>Cradock, 4 November 1838</b> joins Booysen
      to Mountjoy. <b>Mayfair, 15 January 1949</b> is where this archive stops and the Lerena one
      begins.</blockquote>
  </div>
  <div class="grid g3" style="margin-top:20px">
    {places.slice(0, 9).map(([p, rs]) => (
      <div class="panel">
        <div class="lab">{rs.length === 1 ? "one marriage" : rs.length + " marriages"}</div>
        <h3 style="margin:6px 0 8px;font-size:17px">{p}</h3>
        <p class="cap" style="margin:0">{rs.map(r => r.d).join(" · ")}</p>
      </div>
    ))}
  </div>
</section>

<Rule name="gable" label="In order" />

<section class="blk">
  <div class="scroll">
    <table>
      <thead><tr>
        <th class="m" style="width:9rem">When</th><th style="width:11rem">Where</th>
        <th style="width:22rem">Who</th><th>What the record says</th>
      </tr></thead>
      <tbody>
        {rows.map(r => (
          <tr>
            <td class="m">{r.d}</td>
            <td>{r.p === "—" ? <span class="m">not recorded</span> : <b>{r.p}</b>}</td>
            <td>
              {r.H && <a href={u("/who/" + r.H.slug + "/")}>{r.H.n}</a>}
              {r.H && r.W ? <span class="m"> &amp; </span> : null}
              {r.W && <a href={u("/who/" + r.W.slug + "/")}>{r.W.n}</a>}
              <div style="margin-top:5px">
                <span class={"chip " + (r.via === "tree" ? "lore" : "doc")}>
                  {r.via === "tree" ? "family tree" : "a record read here"}</span>
              </div>
            </td>
            <td>{r.n} {r.src && <a href={u(r.src[1])}>{r.src[0]} &rarr;</a>}</td>
          </tr>
        ))}
      </tbody>
    </table>
  </div>
</section>

<Rule name="gable" label="And the lines they joined" />

<section class="blk">
  <h2>The lines a marriage joins</h2>
  <div class="prose">
    <p>A marriage is an event. <b>A line is what the event joined</b> — and until now this page could
      name every marriage without once naming the eleven lines they brought together. They are
      ordered by the generation each first appears in.</p>
    <p><b>Nobody is in a line because of their surname.</b> Every person in this archive carries a
      line already, assigned and written down, so what follows is this archive's own judgement read
      back — not a string comparison run while the page was being built.</p>
  </div>
</section>

<Marriages u={u} groups={GROUPED} openAt={8} />

<section class="blk">
  <h2>Three of them are not ordinary</h2>
  <div class="grid g3" style="margin-top:16px">
    <div class="panel">
      <div class="lab">8 July 1901</div>
      <h3 style="margin:6px 0 8px;font-size:17px">A wedding under martial law</h3>
      <p style="font-size:15px">Pretorius and Barry married <em>"in woonhuis D. Schoeman"</em> at
        Caerlaverock &mdash; in the house of a man tried as a Cape Rebel <b>the month before</b>, and
        witnessed by him. <a href={u("/rebels/")}>The rebels &rarr;</a></p>
    </div>
    <div class="panel">
      <div class="lab">21 September 1908</div>
      <h3 style="margin:6px 0 8px;font-size:17px">Four months after the child</h3>
      <p style="font-size:15px">A miner of twenty-two and a girl of sixteen whose parents had to consent,
        at Indwe. Their son had been born on 31 May and was baptised <em>onecht</em> in December, because
        the register records status at birth. <a href={u("/documents/#indwe-1907")}>Indwe &rarr;</a></p>
    </div>
    <div class="panel">
      <div class="lab">30 December 1924</div>
      <h3 style="margin:6px 0 8px;font-size:17px">The line closing on itself</h3>
      <p style="font-size:15px">First cousins once removed, sixty-five years after the Barry surname left
        this family. The names had never left. <a href={u("/cousins/")}>The cousin marriage &rarr;</a></p>
    </div>
  </div>
  <p class="cap" style="margin-top:20px">
    <a href={u("/households/")}>The households &rarr;</a> ·
    <a href={u("/namesakes/")}>The namesakes &rarr;</a> ·
    <a href={u("/places/")}>The places &rarr;</a></p>
</section>
</Base>
