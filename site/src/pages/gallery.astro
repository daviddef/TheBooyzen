---
import Base from "../layouts/Base.astro";
import Rule from "../components/Rule.astro";
import { u } from "../lib/url.js";
import Gallery from "@daviddef/archive-kit/components/Gallery.astro";
import g from "../data/gallery.json";
const items = g.items;
const sheets = items.filter(i => !i.detail);
const details = items.filter(i => i.detail);

/* Whole sheets and magnified details were two grids split by a boolean; they
   are one grid with that boolean as the filter. The alt text this archive
   writes - a sentence for a screen reader, distinct from the caption under the
   plate - is the thing the other three do not have and the component now asks
   every archive for. */
const plates = items.map((i) => ({
  src: u(i.src.replace("/TheBooyzen", "")),
  alt: i.alt,
  title: i.cap,
  kind: i.detail ? "detail" : "whole document",
  href: i.page || "",
  hrefLabel: i.pagetitle ? `Read it on ${i.pagetitle}` : "Where it is read",
}));
---
<Base title="The plates"
      eyebrow={`${items.length} images · ${sheets.length} whole documents, ${details.length} details`}
      dek="Every document image on this site in one place, each with the caption it carries on its own page and a link back to where it is read. Nothing here is decorative — it is all evidence, and most of it sat unread on a family tree for years.">

<section class="blk">
  <p class="note">Click any plate to open it. The caption under each is the same one the archive uses
    where the document is discussed, so if a reading is corrected there it is corrected here.</p>
</section>

<Rule name="gable" label="Every plate" />

<section class="blk">
  <Gallery rows={plates} u={u} unit="images" />
</section>


{/* The style block that stood here held five declaration TAILS and not one
   selector - "background:var(--panel); ... }" with nothing to apply it to. It
   is what was left when this page's own lightbox moved to the kit's Gallery
   component and the selectors went with it. esbuild had been reporting it as a
   css-syntax-error on every build since; the browser had been discarding it in
   silence, which is why nothing looked wrong. The kit component ships its own
   styles, so there is nothing here to keep. */}

</Base>
