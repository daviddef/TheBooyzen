---
import Base from "../layouts/Base.astro";
import Rule from "../components/Rule.astro";
import { u } from "../lib/url.js";
import g from "../data/gallery.json";
const items = g.items;
const sheets = items.filter(i => !i.detail);
const details = items.filter(i => i.detail);
---
<Base title="The plates"
      eyebrow={`${items.length} images · ${sheets.length} whole documents, ${details.length} details`}
      dek="Every document image on this site in one place, each with the caption it carries on its own page and a link back to where it is read. Nothing here is decorative — it is all evidence, and most of it sat unread on a family tree for years.">

<section class="blk">
  <p class="note">Click any plate to open it. The caption under each is the same one the archive uses
    where the document is discussed, so if a reading is corrected there it is corrected here.</p>
</section>

<Rule name="gable" label={`${sheets.length} documents, whole`} />

<section class="blk">
  <div class="pgrid">
    {sheets.map((i, n) => (
      <button class="plate" type="button" data-i={items.indexOf(i)}>
        <img src={u(i.src.replace("/TheBooyzen", ""))} alt={i.alt} loading="lazy" decoding="async" />
        <span class="pc">{i.cap.slice(0, 96)}</span>
      </button>
    ))}
  </div>
</section>

<Rule name="awl" label={`${details.length} details, magnified`} />

<section class="blk">
  <div class="pgrid det">
    {details.map(i => (
      <button class="plate" type="button" data-i={items.indexOf(i)}>
        <img src={u(i.src.replace("/TheBooyzen", ""))} alt={i.alt} loading="lazy" decoding="async" />
        <span class="pc">{i.cap.slice(0, 96)}</span>
      </button>
    ))}
  </div>
</section>

<div class="lbox" id="lbox" hidden>
  <button class="lx" type="button" aria-label="Close">Close ✕</button>
  <button class="lnav lprev" type="button" aria-label="Previous">‹</button>
  <button class="lnav lnext" type="button" aria-label="Next">›</button>
  <figure>
    <img id="limg" src="" alt="" />
    <figcaption><span id="lcap"></span> <a id="lpage" href="#">Read it in place &rarr;</a></figcaption>
  </figure>
</div>

<style>
  .pgrid { display:grid; gap:12px; grid-template-columns:repeat(auto-fill,minmax(190px,1fr)); margin-top:14px; }
  .pgrid.det { grid-template-columns:repeat(auto-fill,minmax(280px,1fr)); }
  .plate { display:flex; flex-direction:column; gap:7px; padding:8px; cursor:pointer; text-align:left;
    background:var(--panel); border:1px solid var(--rule); border-radius:3px; color:inherit; }
  .plate:hover { border-color:var(--accent); }
  .plate img { display:block; width:100%; height:170px; object-fit:cover; object-position:50% 12%;
    border-radius:2px; background:var(--panel-2); }
  .pgrid.det .plate img { height:96px; object-position:50% 50%; }
  .plate .pc { font-family:var(--sans); font-size:11.5px; line-height:1.45; color:var(--ink-3); }
  .lbox { position:fixed; inset:0; z-index:90; background:rgba(12,14,10,.94); display:flex;
    align-items:center; justify-content:center; padding:56px 20px 20px; }
  .lbox[hidden] { display:none; }
  .lbox figure { margin:0; max-width:1100px; max-height:100%; display:flex; flex-direction:column; gap:12px; }
  .lbox img { max-width:100%; max-height:78vh; object-fit:contain; background:#fff; border-radius:3px; }
  .lbox figcaption { font-family:var(--sans); font-size:13.5px; line-height:1.6; color:#DCE4D6;
    display:flex; gap:14px; flex-wrap:wrap; align-items:baseline; }
  .lbox figcaption a { color:#E3C58A; }
  .lx { position:absolute; top:14px; right:16px; }
  .lnav { position:absolute; top:50%; transform:translateY(-50%); font-size:30px; padding:6px 16px; }
  .lprev { left:10px; } .lnext { right:10px; }
  .lbox button { background:transparent; border:1px solid rgba(255,255,255,.35); color:#fff;
    border-radius:999px; font-family:var(--sans); font-size:13px; padding:7px 14px; cursor:pointer; }
  .lbox button:hover { border-color:#fff; }
</style>

<script is:inline define:vars={{ ITEMS: g.items, BASE: u("") }}>
(function () {
  var box = document.getElementById("lbox"), img = document.getElementById("limg"),
      cap = document.getElementById("lcap"), pg = document.getElementById("lpage");
  var base = BASE.replace(/\/+$/, ""), at = 0;
  function show(i) {
    at = (i + ITEMS.length) % ITEMS.length;
    var it = ITEMS[at];
    img.src = base + it.src.replace("/TheBooyzen", "");
    img.alt = it.alt || it.cap;
    cap.textContent = it.cap || it.alt;
    if (it.page) { pg.href = base + it.page; pg.hidden = false;
      pg.textContent = "Read it on " + it.pagetitle + " →"; }
    else pg.hidden = true;
    box.hidden = false;
    document.body.style.overflow = "hidden";
  }
  function hide() { box.hidden = true; document.body.style.overflow = ""; }
  [].forEach.call(document.querySelectorAll(".plate"), function (b) {
    b.addEventListener("click", function () { show(+b.getAttribute("data-i")); });
  });
  box.querySelector(".lx").addEventListener("click", hide);
  box.querySelector(".lprev").addEventListener("click", function (e) { e.stopPropagation(); show(at - 1); });
  box.querySelector(".lnext").addEventListener("click", function (e) { e.stopPropagation(); show(at + 1); });
  box.addEventListener("click", function (e) { if (e.target === box) hide(); });
  document.addEventListener("keydown", function (e) {
    if (box.hidden) return;
    if (e.key === "Escape") hide();
    if (e.key === "ArrowLeft") show(at - 1);
    if (e.key === "ArrowRight") show(at + 1);
  });
})();
</script>
</Base>
