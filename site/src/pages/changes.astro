---
import Base from "../layouts/Base.astro";
import { u } from "../lib/url.js";
import { md } from "../lib/md.js";
import Changes from "@daviddef/archive-kit/components/Changes.astro";
import Rule from "../components/Rule.astro";
import log from "../data/log.json";
import corr from "../data/corrections.json";
import tl from "../data/timeline.json";
import d from "../data/dossiers.json";

/* Everything on this page is derived. Nothing is written by hand, so it cannot
   go stale the way a hand-kept "latest news" box always does. */
const MONTHS = { Jan:0, Feb:1, Mar:2, Apr:3, May:4, Jun:5, Jul:6, Aug:7, Sep:8, Oct:9, Nov:10, Dec:11 };
function parse(s) {
  const m = /^(\d{1,2})\s+([A-Za-z]{3})\s+(\d{4})$/.exec((s || "").trim());
  return m ? new Date(Date.UTC(+m[3], MONTHS[m[2]], +m[1])) : null;
}
const stamp = e => { const t = parse(e.d); return t ? t.getTime() : 0; };

const entries = [...log.entries].map(e => ({ ...e, t_: stamp(e) }));
const rows    = corr.rows.map(r => ({ d: r[0], was: r[1], now: r[2], cause: r[3], h: r[4], t_: stamp({ d: r[0] }) }));

/* Group by day, newest first, and keep only days that actually carry something. */
const days = {};
for (const e of entries) (days[e.d] ||= { d: e.d, t_: e.t_, log: [], corr: [] }).log.push(e);
for (const r of rows)    (days[r.d] ||= { d: r.d, t_: r.t_, log: [], corr: [] }).corr.push(r);
const ordered = Object.values(days).sort((a, b) => b.t_ - a.t_);

const KIND = { find: "Found", back: "Taken back", work: "Method" };
const CAUSE = corr.causes;
/* A withdrawal and a finding are both things that happened on a day, and this
   page was right to set them down together. Kept that way: the strikethrough
   table lives on /corrections/, which is where the full cause list is. */
const shared = ordered.map((day) => ({
  when: day.d,
  entries: [
    ...day.corr.map((r) => ({
      title: `<s>${md(r.was)}</s>`, kind: KIND.back,
      found: md(r.now) + (r.h ? ` <a href="${u(r.h)}">&rarr;</a>` : ""),
      did: CAUSE[r.cause] || r.cause,
    })),
    /* `w` IS THE SAME FIELD /research-log/ DRAWS, AND THE TWO PAGES READ IT
       DIFFERENTLY UNTIL 9 OCTOBER. Here it was spliced into an HTML string and
       there it was printed as text, so its four emphasis tags rendered on this
       page and showed as literal markup on that one. Both run it through md()
       now, and the tags it used to carry are written as the archive's own
       markers in log.json. `t` carries none and stays text. */
    ...day.log.map((e) => ({ title: e.t, kind: KIND[e.k] || e.k, found: md(e.w) })),
  ],
}));

/* 9 October 2026. The research log folded in here. Its timeline was this page's own
   entries, drawn from the same log.json, so nothing in it is lost; what was NOT
   duplicated was its framing note and its synthesis of what the retractions have in common,
   and both are below. The framing note said «there are more retractions here than
   findings». The data says otherwise (counted below), so the sentence is derived from the
   data and cannot be wrong the way that one was. /research-log/ and /log redirect here. */
const nFind = entries.filter((e) => e.k === "find").length;
const nBack = entries.filter((e) => e.k === "back").length;
const nWork = entries.length - nFind - nBack;
const latest = ordered[0];
const people = Object.keys(d.people).length;
const events = (tl.events || []).length;
---
<Base title="What changed"
      eyebrow={`${entries.length} log entries · ${rows.length} corrections · newest first`}
      dek="This archive is rewritten most days, and a reader who saw it last week has no way of knowing what moved. This page is that record — every finding and every withdrawal, by the day it happened, built from the same data the rest of the site is built from. Nothing here is written by hand.">

<section class="blk">
  <div class="grid g3">
    <div class="panel"><h3 style="margin-top:0">Last worked</h3>
      <p style="font-size:1.4rem;margin:0"><b>{latest && latest.d}</b></p>
      <p class="cap">{latest && latest.log.length} findings · {latest && latest.corr.length} withdrawals</p></div>
    <div class="panel"><h3 style="margin-top:0">Standing</h3>
      <p style="font-size:1.4rem;margin:0"><b>{people}</b> people</p>
      <p class="cap">{events} events on the timeline</p></div>
    <div class="panel"><h3 style="margin-top:0">Taken back</h3>
      <p style="font-size:1.4rem;margin:0"><b>{rows.length}</b> published claims</p>
      <p class="cap">withdrawn since this archive began &mdash; <a href={u("/corrections/")}>with the cause of each</a></p></div>
  </div>
</section>

<section class="blk">
  <div class="note">
    <strong>This log holds {nFind} findings, {nBack} retractions and {nWork} working entries,</strong> and the
    corrections register beside it holds {rows.length} withdrawn claims. Every claim on this site that was
    later withdrawn is listed with what replaced it. Nothing has been quietly deleted: where a page carried
    a wrong reading, the page still says so. <a href={u("/corrections/")}>The corrections, sorted by what
    caused each &rarr;</a> The causes turn out to repeat, and <a href="#in-common">what they have in
    common</a> is at the foot of this page.
  </div>
</section>

<Changes days={shared} u={u} />

<section class="blk">
  <div class="prose">
    <p class="cap">Built from <span class="m">log.json</span> and <span class="m">corrections.json</span>
      at build time. If a finding is not here it is not in the log, and the build will say so before it
      says anything else &mdash; <span class="m">tools/drift.py</span> fails the build when a narrative
      page and the data disagree. <a href={u("/corrections/")}>What was taken back &rarr;</a></p>
  </div>
</section>

<Rule name="koppie" />

<section class="blk" id="in-common">
  <h2>What the retractions have in common</h2>
  <div class="prose">
    <p>Read them together and they fall into three kinds, and only one is about the records.</p>
    <p><b>Reading a document too eagerly.</b> “Armadale”, the two Barry sisters, the z in an 1879
      signature. In each case a faint or ambiguous mark was resolved in the direction that made the better
      story, and the correction came from looking harder or from a better scan.</p>
    <p><b>Not propagating a correction.</b> “Orphaned at seventeen” survived in four places after the date
      behind it had already been fixed. A correction is not finished when the fact changes; it is finished
      when everything that leaned on the fact changes.</p>
    <p><b>Reporting a search as wider than it was.</b> The worst of them. The Farm List negative was
      recorded before checking what the register held. A filtered search of the Cape archives was written
      up as though it were the whole search, and twenty documents went unread — including
      <b>James Mountjoy's own wills</b>. Both were failures of description, not of luck, and both would
      have misled a later reader for years.</p>
    <blockquote>The distinction this archive keeps insisting on — “there is nothing there” against
      “nobody has looked” — is exactly the one it broke twice itself.</blockquote>
    <p><a href={u("/searched/")}>What has been searched &rarr;</a> ·
       <a href={u("/method/")}>How this archive works &rarr;</a> ·
       <a href={u("/open-questions/")}>What is still open &rarr;</a></p>
  </div>
</section>
</Base>
