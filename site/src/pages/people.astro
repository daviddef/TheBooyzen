---
import Base from "../layouts/Base.astro";
import FilterTable from "@daviddef/archive-kit/components/FilterTable.astro";
import { u } from "../lib/url.js";
import d from "../data/dossiers.json";
import pj from "../data/people.json";
/* Iterate the FULL people list, not the deduped dossiers: three names are
   carried by more than one person here and the index must not hide them. */
const bySlug = d.people;
const slugOf = (n) => Object.values(bySlug).find(x => x.n === n || (x.also || []).some(a => a.n === n));
const people = pj.people.map(p => {
  const host = Object.values(bySlug).find(x => x.n === p.n || (x.also || []).some(a => a.n === p.n && a.b === p.b));
  return { ...p, slug: host ? host.slug : "", mentions: host ? host.mentions : 0,
           pages: host ? host.pages : [], shared: host ? host.shared : false };
});
const lines = pj.lines;
const counted = lines.map(l => [l, people.filter(p => p.l === l).length]).filter(([, n]) => n > 0);
const sorted = [...people].sort((a, b) => {
  const s = (x) => (x.n.split(" ").slice(-1)[0] + " " + x.n).toLowerCase();
  return s(a) < s(b) ? -1 : 1;
});
const label = { doc: "Documented", inf: "Inferred", lore: "Testimony", open: "Open" };
---
<Base title="The People"
      eyebrow={`${people.length} people, ${counted.length} families`}
      dek="Every named person in this archive, with the records that carry them and the pages where they are discussed. Type to filter by name, family, place, spelling variant or anything in the notes.">

<section class="blk">
  <h2>Search</h2>
  <div class="panel" style="margin-top:16px">
    <FilterTable
      unit="people"
      note="Filter by name, family, year, place, or a spelling variant such as <em>Montjoy</em>, <em>Kumm</em> or <em>Booÿse</em>."
      columns={[{ label: "Name" }, { label: "Born", cls: "m" }, { label: "Died", cls: "m" },
                { label: "In this archive" }]}
      facets={[{ key: "line", label: "Line", all: `All (${people.length})`,
                 options: counted.map(([l, n]) => ({ v: l, label: `${l} (${n})` })) }]}
      rows={sorted.map((p) => ({
        /* Only what the row does not already print. The name, the variants,
           the dates, the note, the confidence word and the line are all in the
           cells below and the shared script reads them there. What is NOT on
           screen is the titles of the pages that mention this person - the
           dossier's `pages`, which is a different field from the `p` links the
           last cell renders - and that is worth keeping searchable. */
        extraHay: [...new Set((p.pages || []).map((x) => x.t).join(" ").toLowerCase()
          .split(/\s+/).filter(Boolean))].join(" "),
        facets: { line: p.l },
        cells: [
          `<a href="${u("/who/" + p.slug + "/")}"><strong>${p.n}</strong></a>` +
            (p.g ? `<span class="m cap"> · generation ${p.g}</span>` : "") +
            (p.v ? `<div class="cap" style="margin-top:3px">also written ${p.v}</div>` : "") +
            `<div style="margin-top:6px"><span class="chip ${p.s}">${label[p.s]}</span>` +
            (p.mentions > 0 ? `<span class="cap" style="margin-left:8px">${p.mentions} mention${p.mentions === 1 ? "" : "s"}</span>` : "") + "</div>",
          p.b, p.d,
          `<div>${p.r}</div><div style="margin-top:8px;display:flex;flex-wrap:wrap;gap:6px">` +
            p.p.map(([t, h]) => `<a class="plink" href="${u(h)}">${t}</a>`).join("") + "</div>",
        ],
      }))} />
  </div>
</section>

<section class="blk">

</Base>
