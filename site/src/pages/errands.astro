---
import Base from "../layouts/Base.astro";
import Rule from "../components/Rule.astro";
import Errands from "@daviddef/archive-kit/components/Errands.astro";
import { u } from "../lib/url.js";
import er from "../data/errands.json";
import L from "../data/letters.json";
const places = er.places;

/* 9 October 2026. The letters page folded in here. It was the sent half of this
   page's own subject, and it sat beside it saying so ("this one is narrower: it
   is only the post"). Two pages kept one list in two places, and the cost showed
   up the day they were put side by side: this page said "three letters are out
   and none has been answered" while the data held thirteen gone out and three
   answered. So the counts below are DERIVED from letters.json, and cannot go
   stale the way that sentence did. /letters/ redirects here. */
const S = {
  "answered": ["Answered", "#12703F"], "answered in full": ["Answered", "#12703F"],
  "half delivered": ["Half delivered", "#B04A16"], "sent": ["Sent", "#1E5F8C"],
  "no answer": ["No answer", "#E9A020"],
  "drafted": ["Drafted", "#7A7A7A"], "drafted, unsent": ["Drafted", "#7A7A7A"],
  "not yet written": ["Not written", "#7A7A7A"],
};
const letters = L.rows;
const isDraft = (r) => r.state === "drafted" || r.state === "drafted, unsent" || r.state === "not yet written";
const drafted = letters.filter(isDraft).length;
const out = letters.length - drafted;
const answered = letters.filter((r) => r.state === "answered" || r.state === "answered in full").length;
const owed = letters.filter((r) => !isDraft(r) && r.state !== "answered" && r.state !== "answered in full").length;
const NUM = ["no", "one", "two", "three", "four", "five", "six", "seven", "eight", "nine", "ten", "eleven", "twelve",
  "thirteen", "fourteen", "fifteen", "sixteen", "seventeen", "eighteen", "nineteen", "twenty"];
const word = (n) => (n < NUM.length ? NUM[n] : String(n));
const cap = (s) => s[0].toUpperCase() + s.slice(1);
const total = places.reduce((n, p) => n + p.asks.length, 0);
const motifs = ["windpump", "gable", "wagon", "koppie"];

/* 21 September 2026. The ask moved to the kit. The GROUPING did not, and it
   is the thing that makes this page different from the other three: they
   group by how a request is going, and this one groups by DOOR, because the
   questions left here each end at a building somebody could walk into. So a
   place is a group and each of its asks is a row. */
const groups = places.map((pl) => ({
  label: pl.where,
  note: pl.why,
  rows: pl.asks.map(([ref, what]) => ({ what, ref })),
}));
---
<Base title="Errands"
      eyebrow={`${places.length} doors · ${total} things that could be settled behind them · ${letters.length} letters, ${owed} still owed an answer`}
      dek="Four questions in this archive now end at a building rather than a search box. This page is what somebody standing at each door could settle, with the references written out so nobody has to find them twice.">

<section class="blk">
  <h2>Why this page exists</h2>
  <div class="prose">
    <p>{er.note}</p>
    <blockquote>Everything on this site was read from Australia, off microfilm, through a browser. That
      has taken the work a long way and it has now stopped in four specific places &mdash; not for want
      of searching, but because the records are <b>restricted, unfilmed, or catalogued in a way no name
      search can reach</b>.</blockquote>
    <p>{cap(word(out))} letters have gone out and {word(answered)} {answered === 1 ? "has" : "have"} been
      answered; {word(drafted)} more are drafted and unsent. <a href="#sent">The letters, and what came back &darr;</a>
      If you are near any of these buildings, or know
      somebody who is, <b>the references below are complete</b> and every one has been checked against a
      catalogue or a film. <a href={u("/sources/")}>Sources &rarr;</a></p>
  </div>
</section>

{groups.map((g, i) => (
  <div>
    <Rule name={motifs[i % motifs.length]} />
    <section class="blk">
      <h2>{g.label}</h2>
      <p class="cap" style="margin-top:4px">{places[i].addr}</p>
      <div style="margin-top:18px"><Errands groups={[g]} u={u} html={false} /></div>
      {places[i].note && <p class="note" style="margin-top:16px">{places[i].note}</p>}
    </section>
  </div>
))}

<Rule name="awl" />

<section class="blk" id="sent">
  <h2>Sent, and what came back</h2>
  <div class="prose">
    <p set:html={L.note} />
    <p>{cap(word(out))} of the {word(letters.length)} have gone out and {word(answered)}
      {answered === 1 ? "has" : "have"} been answered; {word(owed)} {owed === 1 ? "is" : "are"} still owed an
      answer and {word(drafted)} are drafted and unsent. <a href={u("/worklist/")}>The work list</a> says who has
      to move what.</p>
  </div>
  <div class="scroll" style="margin-top:16px">
    <table>
      <thead><tr><th style="width:7rem">Date</th><th style="width:16rem">To</th><th>Asking for</th><th style="width:8rem">State</th></tr></thead>
      <tbody>
        {letters.map(r => (
          <tr>
            <td class="m">{r.d}</td>
            <td><b>{r.to}</b></td>
            <td>{r.what}<br /><span class="cap">{r.back}</span></td>
            <td class="m" style={`color:${(S[r.state] || ["", "#666"])[1]}`}>{(S[r.state] || [r.state])[0]}</td>
          </tr>
        ))}
      </tbody>
    </table>
  </div>
  <p class="note" style="margin-top:18px"><b>Nothing here was sent on this archive's own authority.</b>
    Every letter above was drafted, shown, and sent only when the user said so &mdash; and the two that
    involve money or a public posting under his name are marked as his to send, not this archive's.</p>
</section>

<Rule name="thorn" />

<section class="blk">
  <h2>And one thing anybody can do</h2>
  <div class="prose">
    <p><b>Read the corrections page before you trust anything here.</b> This archive has published
      twenty-one things it had to take back, and the pattern in them is the most useful thing on the
      site: a negative built from a list mistaken for a population, a search run over part of the ground
      and written up as the whole, a fact read off a reference number and then quoted back as evidence.
      <a href={u("/corrections/")}>What was taken back &rarr;</a></p>
    <p>If you find something here that is wrong, it is wrong on purpose in only one sense: it was
      published so that it could be checked. <a href={u("/method/")}>Method &rarr;</a> ·
      <a href={u("/open-questions/")}>Open questions &rarr;</a></p>
  </div>
</section>
</Base>
