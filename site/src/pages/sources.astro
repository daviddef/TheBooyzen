---
import Base from "../layouts/Base.astro";
import srcState from "../data/sources-state.json";
import { u } from "../lib/url.js";
import sd from "../data/sources.json";
/* THE REGISTER PART OF THIS PAGE IS DATA NOW.
 *
 * Four of these sections are tables of records — what has been read, what is
 * in hand, what is located and still unread — and they were 674 lines of
 * hand-written rows, the largest sources page in the estate. tools/
 * extractsources.py lifted them into sources.json AS THE HTML THEY ALREADY
 * WERE, so nothing is reworded and nothing is summarised: the only change is
 * that href={u("/x/")} became href="/x/" and the base goes back on here. That
 * is what makes it checkable — strip the tags off the rebuilt page and the
 * reading text has to be the same text.
 *
 * The rest of the page stays prose, because the rest of the page argues rather
 * than lists: a book that went the other way when it was read, seven kinds of
 * shut door, a library that is not an archive. Rows would not hold any of it. */
const S = (id) => sd.sections.find(x => x.id === id);
const based = (h) => h.replace(/href="\//g, 'href="' + u("/"));
/* COUNTED OFF THE CHIPS, WHICH IS ONLY POSSIBLE NOW THEY ARE ROWS.
   It says how many carry no status at all, because that is the thing worth
   seeing: nine of the ten Transvaal estates are graded Read, Blocked or Not
   found, and the tenth says "Index read; no image offered" in prose and wears
   no chip. A tally that quietly counted nine would hide the one row that has
   never been graded, which is the opposite of what a register is for. */
const tally = (id) => {
  const rows = S(id).rows;
  const seen = {};
  let none = 0;
  for (const r of rows) {
    const m = r.map(c => c.h).join(" ").match(/<span class="chip [a-z]+">([^<]*)<\/span>/);
    if (m) seen[m[1]] = (seen[m[1]] || 0) + 1; else none++;
  }
  const parts = Object.entries(seen).sort((a, b) => b[1] - a[1])
    .map(([k, v]) => v + " " + k.toLowerCase());
  if (none) parts.push(none + (none === 1 ? " with no status recorded" : " with no status recorded"));
  return rows.length + " references \u2014 " + parts.join(", ") + ".";
};
---
<Base title="Sources"
      eyebrow="What is behind each claim"
      dek="Everything documented in this archive traces to one of the records below. Where a claim is inferred or is family testimony, the page carrying it says so.">

<section class="blk">
  <h2>The primary tree</h2>
  <p><b>MyHeritage — <em>Defranceski Family Site (23andMe)</em></b>, the family tree
    <em>"Defranceski, Lerena, Taylor, Barry, Blazevic, Booyzen"</em>, 15,643 people. Read
    <b>9 September 2026</b> from David Defranceski's account.</p>
  <p class="cap">The tree is private and its profile pages are not publicly linkable. Everything taken from
    it is reproduced here with its own citation where it carries one, and marked as uncited where it does
    not. MyHeritage interface marks — confirmed Smart Matches, direct-ancestor stars — are
    <b>not</b> treated as sources. <a href={u("/method/")}>Method &rarr;</a></p>
</section>

<section class="blk">
  <h2>Records cited within that tree</h2>
  <p class="dek">Each of these is a FamilySearch ark or a FindMyPast transcript recorded against a specific
    fact. They are listed so that anyone can go and look at the image rather than take this archive's word
    for it. <b>None has yet been independently re-read by this archive.</b></p>
  <div class="scroll" style="margin-top:18px">
    <table>
      <thead><tr><th style="width:20rem">Fact</th><th>Collection</th><th class="m">Reference</th></tr></thead>
      <tbody>{sd.fs.map(r => (
        <tr><td>{r.fact}</td><td class="cap">{r.collection}</td><td class="m">{r.ref}</td></tr>))}</tbody>
    </table>
  </div>
  <p class="cap">FamilySearch arks resolve at <span class="m">familysearch.org/ark:/61903/&lt;reference&gt;</span>.
    Collections citing the <em>State Archives, Cape Province</em> and <em>Pietermaritzburg Archives</em> are
    named as FamilySearch gives them.</p>
</section>

<section class="blk">
  <h2>Original documents read by this archive</h2>
  <p class="dek">Extracted at full resolution from the MyHeritage photo store on 9 September 2026 and
    transcribed directly. Images and transcriptions are on <a href={u("/documents/")}>The documents</a>;
    originals are kept in <span class="m">sources/booyzen-photos/</span>.</p>
  <div class="scroll" style="margin-top:18px">
    <table>
      {S("read").cols.length > 0 && (
      <thead><tr>{S("read").cols.map(c => (
        <th class={c.cls || null} style={c.w ? "width:" + c.w : null} set:html={c.label} />))}</tr></thead>)}
      <tbody>{S("read").rows.map(r => (
        <tr>{r.map(c => (<td class={c.cls || null} set:html={based(c.h)} />))}</tr>))}</tbody>
    </table>
  </div>
</section>

<section class="blk">
  <h2>Estate and archival references in hand</h2>
  <div class="scroll">
    <table>
      {S("inhand").cols.length > 0 && (
      <thead><tr>{S("inhand").cols.map(c => (
        <th class={c.cls || null} style={c.w ? "width:" + c.w : null} set:html={c.label} />))}</tr></thead>)}
      <tbody>{S("inhand").rows.map(r => (
        <tr>{r.map(c => (<td class={c.cls || null} set:html={based(c.h)} />))}</tr>))}</tbody>
    </table>
  </div>
</section>

<section class="blk">
  <h2>The Transvaal, before anyone thought this family was there</h2>
  <p class="dek">Three notices found by reading a surname rather than chasing a reference. The first of
    them is the oldest document in this archive.</p>
  <div class="scroll" style="margin-top:16px">
    <table>
      {S("transvaal").cols.length > 0 && (
      <thead><tr>{S("transvaal").cols.map(c => (
        <th class={c.cls || null} style={c.w ? "width:" + c.w : null} set:html={c.label} />))}</tr></thead>)}
      <tbody>{S("transvaal").rows.map(r => (
        <tr>{r.map(c => (<td class={c.cls || null} set:html={based(c.h)} />))}</tr>))}</tbody>
    </table>
  </div>
  <p style="margin-top:16px"><b>How they were found matters more than what they say.</b> The nine
    references below came from NAAIRS, one search at a time, and this archive spent days working through
    them. These three came from asking FamilySearch's Transvaal probate collection for
    <span class="m">every indexed BOOYSEN and BOOYZEN at once</span> and reading the list. That took
    minutes. The lesson is recorded on <a href={u("/searched/")}>What was searched</a>, because it is the
    method that failed, not the archive.</p>
</section>

<section class="blk">
  <h2>The Transvaal estates — located, and mostly still unread</h2>
  <p class="dek">Found only after this archive noticed it had spent its life searching the Cape depot
    alone. Every reference below is in hand; <b>three have been read</b>, and one of the three arrived
    unlooked-for.</p>
  <div class="scroll" style="margin-top:16px">
    <table>
      {S("estates").cols.length > 0 && (
      <thead><tr>{S("estates").cols.map(c => (
        <th class={c.cls || null} style={c.w ? "width:" + c.w : null} set:html={c.label} />))}</tr></thead>)}
      <tbody>{S("estates").rows.map(r => (
        <tr>{r.map(c => (<td class={c.cls || null} set:html={based(c.h)} />))}</tr>))}</tbody>
    </table>
  </div>
  <p class="cap" style="margin-top:14px">{tally("estates")}</p>
  <p style="margin-top:16px">The Transvaal probate collection is digitised, so these are readable rather
    than orderable — each should carry a <b>Sterfkennis</b> naming the deceased's parents, occupation and
    children. Between them they would settle what the men of this family did for a living in
    Johannesburg, which is the last untested line of the family testimony.</p>
  <p class="cap" style="margin-top:10px">Reading them is rate-limited rather than blocked: FamilySearch
    began refusing requests partway through this work and recovers after a rest. The references are
    recorded here so the job resumes rather than restarts.</p>
  <div class="note" style="margin-top:14px">
    <b>And on the afternoon of 13 September that stopped being true.</b> The sentence above describes a
    limiter that opens a window, closes it after twenty or thirty calls, and reopens after about ten
    minutes. That is how it behaved all week. It is worth writing down that it can do something worse.
    <br /><br />
    After two searches that afternoon the refusals did not lift. Waits of four, twenty-five, thirty and
    forty seconds all returned <span class="m">403</span>, and the block then spread <b>off the search
    service and onto the site</b>: loading an ordinary results page in a browser produced a document with
    <b>a body of zero characters</b> &mdash; not a refusal page, not an error, nothing at all. Nearly an
    hour of rests did not clear it.
    <br /><br />
    <b>Two practical things follow.</b> The first is that polling probably makes it worse, and checking
    every few minutes to see whether it has lifted is the opposite of the right move. The second is the
    one that matters to anybody reading a result on this site: <b>a search that has to be abandoned
    halfway is a different kind of negative from one that ran.</b> Where that happened, the row on
    <a href={u("/searched/")}>What has been searched</a> is marked
    <span class="chip open">Blocked</span> and not <span class="chip lore">Nothing</span>, because the
    index was never actually asked.
  </div>
  <div class="note" style="margin-top:18px">
    <b>13 September 2026: the remaining six are blocked, and it is not an indexing problem.</b>
    The collection is held on <b>762 films</b>, <span class="m">007805260</span> to
    <span class="m">007831001</span>. Every film up to and including <span class="m">007830062</span>
    serves its images. <b>Film <span class="m">007830063</span> and every film after it returns 403</b>
    &mdash; twenty-eight tested, twenty-eight refused &mdash; and those are exactly the films whose
    indexed records run to 1946 and later.
    <br /><br />
    <b>Five of the six sit behind that line</b>: 3734/46, 1095/48, 5155/51, 769/52 and 10/57. No amount
    of browsing reaches them. The sixth, <b>52653 of 1923</b>, is in the open half &mdash; but it is not
    name-indexed, and the films are not ordered by estate number. Image 100 of three films in the same
    numeric neighbourhood gave a 1920 Sterfkennis, a 1938 death notice, and <b>a Chinese clan
    genealogy</b>. There is nothing to interpolate along.
    <br /><br />
    <b>So this queue no longer belongs on a screen.</b> The originals are at the
    <b>Transvaal Archives Depot, Pretoria</b>, which is where these six now go.
    <a href={u("/searched/")}>What was searched &rarr;</a>
  </div>

  <p style="margin-top:16px"><b>And one thing learned about the route in.</b> The whole indexed surname
    can be pulled from one collection at a time &mdash; <span class="m">BOOYZEN, exact, collection
    2520237</span> returns 150 people &mdash; which is how the 1942 Daschner file was found without
    knowing it existed. It also settles a negative: <b>the 1946 to 1957 estates in this table are not in
    that index at all.</b> They exist on film and were never keyed, so the remaining six have to be
    reached by browsing images rather than by searching names, and that is a different and slower job.
    <a href={u("/searched/")}>What was searched &rarr;</a></p>
</section>

<section class="blk">
  <h2>Indexes searched, including where they returned nothing</h2>
  <p class="dek">A negative result is only worth recording if the search behind it is stated.</p>
  <div class="scroll">
    <table>
      <thead><tr><th>Index</th><th>Query</th><th class="m">Result</th></tr></thead>
      <tbody>
        <tr><td rowspan="7"><strong>NAAIRS</strong> — National Automated Archival Information Retrieval
          System, <em>Cape Town Archives Repository (KAB)</em></td><td class="m">MOUNTJOY</td><td class="m">42</td></tr>
        <tr><td class="m">MOUNTJOY, beginning date ≥ 1930</td><td class="m">22 — all read</td></tr>
        <tr><td class="m">MONTJOY</td><td class="m">4 — all read</td></tr>
        <tr><td class="m">MOUNTJOY <b>and</b> HERKLAAS</td><td class="m">0</td></tr>
        <tr><td class="m">MOUNTJOY <b>and</b> HERCULES</td><td class="m">0</td></tr>
        <tr><td class="m">MOUNTJOY <b>and</b> WODEHOUSE</td><td class="m">0</td></tr>
        <tr><td class="m">MOUNTJOY <b>and</b> BARKLY</td><td class="m">0</td></tr>
        <tr><td><strong>FamilySearch</strong> full-text search</td><td class="m">"Johannes Mountjoy"</td>
          <td class="m">0 — the collection does not cover Cape probate</td></tr>
      </tbody>
    </table>
  </div>
  <p style="margin-top:16px"><strong>What the zeros mean here.</strong> There is <b>no estate file for
    Hercules Johannes Mountjoy</b> (d. 12 May 1941, Wodehouse) in the Cape Town Archives under any
    spelling. The estates around him run 1938, 1939, 1943, 1946 and 1948 — an unbroken sequence — so this
    is an <em>absence</em>, not a hole in the index. His parentage is instead carried by his
    <b>1866 baptism register entry</b>, which is better evidence than a death notice would have been.</p>
  <p style="margin-top:12px" class="cap"><strong>One correction to an external source.</strong> The
    FamilySearch ark cited by <em>1820settlers.com</em> for James Jonathan Mountjoy
    (<span class="m">3:1:3Q9M-CSQ8-S3QM-6</span>) is not him. It is the death notice of
    <b>Ferdinand Kumm</b>, d. 20 October 1903 at Stutterheim — his father-in-law.</p>
</section>

<section class="blk">
  <h2>Published and reference sources</h2>
  <div class="prose">
    <p><b><a href="https://forebears.io/" rel="noopener">Forebears</a></b> — surname incidence and distribution for <em>Booyzen</em> and <em>Booysen</em>,
      accessed 9 September 2026. Forebears figures are modelled estimates from name-frequency data, not a
      census. <a href={u("/name/")}>The name &rarr;</a></p>
    <p><b><a href="https://en.wikipedia.org/wiki/Booysen" rel="noopener">Wikipedia</a></b>, <em>Booysen</em> — surname etymology and the progenitor Boij Boijeszoon of Barlt,
      Northern Friesland.</p>
    <p><b>Hilary Anne Shearing</b>, <em>The Cape Rebel of the South African War, 1899–1902</em>
      (<a href="https://scholar.sun.ac.za/" rel="noopener">Stellenbosch University</a>) — the standard study; the source of the rebel classification system and the
      scale of the rebellion.</p>
    <p><b>The Van Plettenberg Historical Society</b>, "Cape Rebels 1899–1902" — district rebel numbers,
      trial and sentencing outcomes, the 44 executions and the 409 transportations.</p>
    <p><b><a href="https://angloboerwar.com/" rel="noopener">angloboerwar.com</a></b> — Barkly East and Dordrecht rebel numbers, Commandant D. Schoeman at
      Labuschagne's Nek, Commandant J. F. de Wet and the Barkly East Rebels.</p>
    <p><b>Anglo-Boer War Museum, Bloemfontein — <a href="https://www.wmbr.org.za/" rel="noopener">wmbr.org.za</a></b>, searched 9 September 2026. Fifteen
      registers, including <b>Cape Rebels (12,792)</b>, <b>Joiners (952)</b>, <b>Farm List (10,282)</b>
      and <b>Boer Officers (514)</b>. Records cited here: <span class="m">Cape Rebels ID 8434</span>
      (Schoeman, Daniel Willem, Caerlaverock) and <span class="m">ID 4721</span> (Klopper, Christiaan F.,
      Caerlaverock). <a href={u("/rebels/")}>The rebels &rarr;</a></p>
  </div>
</section>

<section class="blk">
  <h2>Other trees holding this family</h2>
  <p class="dek">Recorded on the MyHeritage profiles as saved records. They are <b>leads, not sources</b> —
    listed here because they are where corroboration or contradiction is most likely to come from.</p>
  <div class="scroll" style="margin-top:16px">
    <table>
      <thead><tr><th style="width:18rem">Tree</th><th>Held by</th><th>Attached to</th></tr></thead>
      <tbody>
        <tr><td>Barry Web Site</td><td>Peter Barry, New Zealand</td><td>Willem Hermanus Booyzen</td></tr>
        <tr><td>Daschner Web Site</td><td>Hilary Bird, Australia</td><td>George D. M. Booyzen; Anna Pretorius</td></tr>
        <tr><td>van Rensburg Web Site</td><td>Wayne van Rensburg, South Africa</td><td>George D. M. Booyzen; Anna Pretorius</td></tr>
        <tr><td>Davis Web Site</td><td>Gillian Davis, South Africa</td><td>George D. M. Booyzen</td></tr>
        <tr><td>Turner Web Site</td><td>Warren Turner, New Zealand</td><td>George D. M. Booyzen</td></tr>
        <tr><td>Martin Hardy Ellis and Family</td><td>Martin Hardy Ellis, United Kingdom</td><td>George D. M. Booyzen</td></tr>
        <tr><td>Labuschagne Web Site</td><td>Herman Labuschagne, South Africa</td><td>Willem Hermanus Booyzen</td></tr>
        <tr><td>Fick family Web Site</td><td>Paula Wiegmink, Australia</td><td>Willem Hermanus Booyzen</td></tr>
        <tr><td>Rademeyer Web Site</td><td>Michael Vincent Rademeyer, South Africa</td><td>Willem Hermanus Booyzen</td></tr>
        <tr><td>du Plessis Web Site</td><td>Etienne Muller du Plessis, South Africa</td><td>Anna Pretorius</td></tr>
        <tr><td>Wandrag–Pretorius–Vermaak–Nortje</td><td>Glen Pretorius, South Africa</td><td>Anna Pretorius</td></tr>
        <tr><td>Štāle Web Site</td><td>Renāte Štāle, Latvia</td><td>Anna Pretorius</td></tr>
        <tr><td>Geni World Family Tree</td><td>—</td><td>Kathleen Barry; John Augustus Barry; George A. Kolbe</td></tr>
        <tr><td>FamilySearch Family Tree</td><td>—</td><td>both Petrus Jacobus Booysens</td></tr>
