---
/* ONE PAGE PER PERSON (23 November 2026, trial). A name this archive holds a person for has no page of its own any more: the
   person's page is /people/<slug>/, it lists the other people who carry the same name, and the old address /who/<name>/ is a
   static redirect to it (astro.config.mjs, from lib/namesets.js: one bearer -> that person's page, a shared name -> its first
   bearer's page at #others-of-this-name).

   What is still drawn here is the NAME PAGE of a person the archive READ in a FamilySearch index row and holds in no family
   file (src/data/readnames.json, tools/readnames.py): there is no person page to send it to, and this page says where the name
   was read and never says two entries are one man or one woman. */
import Base from "../../layouts/Base.astro";
import { u } from "../../lib/url.js";
import readNames from "../../data/readnames.json";
import ReadName from "../../components/ReadName.astro";
import { SETS } from "../../lib/namesakes.js";

export function getStaticPaths() {
  /* a read name whose slug a person already has is that person's: it is not a page here (it is a redirect) */
  return (readNames.names || []).filter((n) => !SETS.has(n.slug))
    .map((n) => ({ params: { slug: n.slug }, props: { name: n.name, read: n } }));
}

const { name, read } = Astro.props;
---
<Base title={name}
      eyebrow="A name read from the records"
      dek={`${name} is in a FamilySearch index entry and in no family file here. This page says where the name was read.`}>
  <section class="blk">
    <ReadName name={name} role={read.role} rows={read.rows} pages={read.pages} base={u("/")} />
    <p class="dek" style="margin-top:1.6rem">A name is not a person. This page does not say that the entries above
    are one man or one woman: this archive never merges records on a name alone.</p>
  </section>
</Base>
