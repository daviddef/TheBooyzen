---
import Base from "../../layouts/Base.astro";
import Rule from "../../components/Rule.astro";
import { u } from "../../lib/url.js";
import Places from "@daviddef/archive-kit/components/Places.astro";
import pl from "../../data/places.json";
const places = pl.places;
const regions = [...new Set(places.map(p => p.r))];
const label = { doc: "Documented", inf: "Inferred", lore: "Testimony", open: "Open" };
const rows = places.map((p) => ({
  name: p.n, href: "/places/" + p.slug + "/", kind: p.k, where: p.r,
  n: (p.e || []).length, note: p.w,
}));
---
<Base title="Places"
      eyebrow={`${places.length} places, ${regions.length} regions`}
      dek="Every place this archive can put a named person in, with the document that puts them there. Farms, villages, churches, hospitals and cemeteries — not a gazetteer, a list of where the evidence actually lands.">

<Rule name="koppie" label="Where the evidence lands" />

<section class="blk">
  <Places rows={rows} u={u} countLabel="Dated events" />
</section>


</Base>
