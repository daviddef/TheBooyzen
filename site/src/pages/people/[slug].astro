---
import Base from "../../layouts/Base.astro";
import Rule from "../../components/Rule.astro";
import { u } from "../../lib/url.js";
import d from "../../data/dossiers.json";
import pl from "../../data/places.json";
import pj from "../../data/people.json";
import PersonTree from "../../components/PersonTree.astro";
import mg from "../../data/marriages.json";
import cx from "../../data/corrections.json";
import cw from "../../data/corrections-who.json";
/* CORRECTIONS REACH THE PERSON THEY ARE ABOUT.
 *
 * corrections.json keys a correction to a PAGE - documents, open questions,
 * the name - and never to a person, so a correction entirely about one named
 * man could be read on /corrections/ and nowhere else, least of all here. The
 * 17 September audit called that the standing gap, as against the fault.
 *
 * tools/correctionswho.py attaches a person only where their WHOLE held name
 * appears, forename and surname together, never a surname alone: matching on
 * part of a name is how this estate once turned Domenica Prostamo into
 * Domenica Anile. 31 of the 63 corrections name somebody held here. */
const ckey = (r) => r[0] + " | " + String(r[1]).slice(0, 80);
import { treeFor, resolve } from "../../lib/kin.js";
export function getStaticPaths() {
  return Object.values(d.people).map(p => ({ params: { slug: p.slug }, props: { p } }));
}
const { p } = Astro.props;
const mine = cx.rows.filter(r => (cw.who[ckey(r)] || []).includes(p.slug));
const label = { doc: "Documented", inf: "Inferred", lore: "Testimony", open: "Open" };
const all = Object.values(d.people);
const kin = all.filter(x => x.slug !== p.slug && x.l === p.l).slice(0, 14);
/* Places name their people, so a person can be given their places for free. */
const places = pl.places.filter(x => (x.p || []).includes(p.n));
/* A page may hold more than one person of the same name; each gets its own
   chart, because merging their families would be the error this archive most
   wants to avoid. */
const selves = [{ n: p.n, b: p.b, d: p.d, r: p.r }, ...(p.also || [])]
  .map(x => pj.people.find(y => y.n === x.n && y.b === x.b) || x);
const hasKin = (self) => {
  const t = treeFor(self);
  return t.parents.length > 0 || t.siblings.length > 0 || t.unions.length > 0;
};
/* THE MARRIAGE RECORD, READ HERE RATHER THAN INFERRED FROM THE CHART.
 *
 * The chart draws a spouse because kin.js says the two were a household. The
 * marriage itself — the date, the town, whether a document or a family tree
 * puts them there, and the source that says so — lives in marriages.json, and
 * until now this page never opened that file. All 34 people it names had their
 * spouse drawn and not one of them had the record of the marriage shown, so a
 * reader could see who somebody married and nothing at all about the evidence.
 *
 * Every reference is resolved through kin.js, which is the archive's own
 * disambiguator: "Petrus Jacobus Booysen|1788" and "Petrus Jacobus Booysen|1812"
 * are a father and a son sharing one page, and attaching the son's two
 * marriages to the father would be the merge-on-a-name error this estate exists
 * to avoid. Matching is on name AND birth, never on name. */
const keyOf = (x) => x.n + "|" + (x.b || "");
const VIA = { doc: "a record read here", tree: "a family tree, not a document",
              inf: "inferred", open: "an open question" };
const marrOf = (self) => mg.rows
  .map((r) => ({ r, H: resolve(r.h), W: resolve(r.w) }))
  .filter((x) => keyOf(x.H) === keyOf(self) || keyOf(x.W) === keyOf(self))
  .map((x) => ({ ...x.r, spouse: keyOf(x.H) === keyOf(self) ? x.W : x.H }))
  .sort((a, b) => (a.ds < b.ds ? -1 : 1));
const byPage = {};
for (const h of p.hits) (byPage[h.page] ||= { title: h.title, hits: [] }).hits.push(h);
const groups = Object.entries(byPage);
---
<Base title={p.n}
      eyebrow={`${p.l} · ${p.mentions === 0 ? "not yet discussed on any page" : p.mentions + " mention" + (p.mentions === 1 ? "" : "s") + " across " + p.pages.length + " page" + (p.pages.length === 1 ? "" : "s")}`}
      dek={p.r}>

<section class="blk">
  {selves.map((self, i) => (
    <div>
      {selves.length > 1 && (
        <h2 style={i ? "margin-top:34px" : "margin-top:0"}>{self.n}<span class="m" style="font-weight:400">{` · ${self.b} – ${self.d}`}</span></h2>
      )}
      <PersonTree person={self} showKey={i === 0} />
      <p class="cap" style="margin:-10px 0 22px">
        <a href={u("/register/?q=" + encodeURIComponent(self.n.replace(/[“”]/g, "")))}>
          Every record naming {self.n.replace(/[“”]/g, "")} &rarr;</a>
      </p>
      {marrOf(self).length > 0 && (
        <div class="panel" style="padding:15px 17px;margin:0 0 22px">
          <h3 class="ct" style="margin:0 0 12px">{marrOf(self).length === 1 ? "The marriage record" : "The marriage records"}</h3>
          {marrOf(self).map(m => (
            <p style="margin:0 0 13px;font-size:15px;line-height:1.62">
              <b>Married {m.spouse.n}</b><span class="m">{" \u00b7 " + m.d + " \u00b7 " + m.p}</span>{" "}
              <span class={"chip " + (m.via === "doc" ? "doc" : m.via === "tree" ? "lore" : m.via)}>{VIA[m.via] || m.via}</span>
              {m.n && <span class="cap" style="display:block;margin-top:5px">{m.n}</span>}
              {m.src && <a class="plink" href={u(m.src[1])} style="display:inline-block;margin-top:7px">{m.src[0]} &rarr;</a>}
            </p>
          ))}
          <p class="cap" style="margin:0"><a href={u("/marriages/")}>Every marriage this archive places &rarr;</a></p>
        </div>
      )}
      {!hasKin(self) && marrOf(self).length === 0 && (
        <p class="note">
          <b>No family is drawn here, because none is recorded.</b> This archive holds
          {" "}{self.n}{" "} as a name on a document &mdash; a witness at a font, a signature on a form, a
          person named in someone else's list &mdash; and has no record of who their parents, spouse or
          children were. That is a statement about the sources, not about the person.
          <a href={u("/register/")}> Every record naming them &rarr;</a>
        </p>
      )}
    </div>
  ))}
</section>

<section class="blk">
  <div class="grid g2" style="margin-top:4px">
    <div class="panel">
      <h2 class="ct" style="margin-top:0">The record</h2>
      <table style="width:100%">
        <tbody>
          <tr><td style="width:7rem">Name</td><td><strong>{p.n}</strong></td></tr>
          {p.v && <tr><td>Also written</td><td>{p.v}</td></tr>}
          <tr><td>Born</td><td class="m">{p.b}</td></tr>
          <tr><td>Died</td><td class="m">{p.d}</td></tr>
          <tr><td>Line</td><td><a href={u("/people/")}>{p.l}</a></td></tr>
          {p.g && <tr><td>Generation</td><td class="m">{p.g} — on the direct line</td></tr>}
          <tr><td>Confidence</td><td><span class={"chip " + p.s}>{label[p.s]}</span></td></tr>
          {p.tree && <tr><td>From a tree</td><td><span class="chip lore">not documented</span>{" "}
            <b>{p.tree}</b> &mdash; the rest of this record rests on documents this archive has read,
            and that part does not.</td></tr>}
        </tbody>
      </table>
    </div>
    <div class="panel">
      <h2 class="ct" style="margin-top:0">What the archive holds</h2>
      <p style="font-size:15.5px">{p.r}</p>
      {p.p && p.p.length > 0 && (
        <p style="margin-top:14px;display:flex;flex-wrap:wrap;gap:6px">
          {p.p.map(([t, h]) => (<a class="plink" href={u(h)}>{t}</a>))}
        </p>
      )}
    </div>
  </div>
</section>

{places.length > 0 && (
<section class="blk">
  <h2>Where the archive puts {p.n.split(" ")[0]}</h2>
  <div class="grid g3" style="margin-top:14px">
    {places.map(x => (
      <a class="cardlink" href={u("/places/" + x.slug + "/")}>
        <div class="nm" style="font-size:16px">{x.n}</div>
        <div class="txt">{x.k} · {x.r}</div>
      </a>
    ))}
  </div>
  <p class="cap" style="margin-top:12px">Each carries the document that puts them there.
    <a href={u("/atlas/")}>The atlas &rarr;</a></p>
</section>
)}

{p.shared && (
<section class="blk">
  <div class="note">
    <strong>More than one person of this name.</strong> This archive holds
    {1 + (p.also || []).length} people called <strong>{p.n}</strong>, and they are gathered here together
    because merging them silently would be worse than saying so. The surrounding text on each page below
    usually makes it clear which is which.
    <ul style="margin:10px 0 0">
      <li><b>{p.n}</b> — {p.b} to {p.d}. {p.r}</li>
      {(p.also || []).map(a => (<li><b>{a.n}</b> — {a.b} to {a.d}. {a.r}</li>))}
    </ul>
  </div>
</section>
)}

{mine.length > 0 && (
<section class="blk">
  <div class="note">
    <strong>{mine.length === 1
      ? "One correction on this site names " + p.n + "."
      : mine.length + " corrections on this site name " + p.n + "."}</strong>
    {" "}A correction here is filed against the page it changed, not against a person,
    so until now it could be read on the corrections register and nowhere else — least
    of all on the page of the person it was about.
    <ul style="margin:12px 0 0">
      {mine.map(r => (
        <li style="margin-bottom:10px">
          <span class="m small">{r[0]}</span> — <b>{r[1]}</b><br />
          <span class="cap">{r[2]}</span>{" "}
          <a href={u(r[4])}>Where it stands &rarr;</a>
        </li>
      ))}
    </ul>
  </div>
</section>
)}

{groups.length > 0 && <Rule name="koppie" label="Every mention, page by page" />}

{groups.map(([route, g]) => (
  <section class="blk">
    <h2><a href={u(route)}>{g.title}</a></h2>
    <div style="margin-top:14px;display:flex;flex-direction:column;gap:13px">
      {g.hits.map(h => (
        <div class="panel" style="padding:14px 16px">
          <p style="font-size:14.5px;line-height:1.66;margin:0">…{h.text}…</p>
        </div>
      ))}
    </div>
  </section>
))}

{groups.length === 0 && (
<section class="blk">
  <p class="note">This person is recorded in the archive's index but is not yet discussed on any page.
    That is itself worth knowing — it usually means a name read off a single document and not yet
    followed up. <a href={u("/open-questions/")}>Open questions &rarr;</a></p>
</section>
)}

<Rule name="thorn" />

<section class="blk">
  <h2>Others on the {p.l} side</h2>
  <div class="grid g3" style="margin-top:16px">
    {kin.map(k => (
      <a class="cardlink" href={u("/who/" + k.slug + "/")}>
        <div class="nm" style="font-size:16px">{k.n}</div>
        <div class="txt">{k.b !== "—" || k.d !== "—" ? `${k.b} – ${k.d}` : k.r.slice(0, 70)}</div>
      </a>
    ))}
  </div>
  <p class="cap" style="margin-top:18px">
    <a href={u("/people/")}>All {all.length} people &rarr;</a> ·
    <a href={u("/places/")}>The places &rarr;</a> ·
    <a href={u("/search/")}>Search the archive &rarr;</a>
  </p>
  <p class="note" style="margin-top:18px">{d.note}</p>
</section>
</Base>
