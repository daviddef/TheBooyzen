{
  "name": "booyzen-archive",
  "type": "module",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "astro dev --port 4324",
    "atlas": "python3 ../tools/atlas.py",
    "build": "npm run check:pin && npm run living:flags && npm run check:decisions && npm run check:letters && npm run check:dates && npm run check:readnames && npm run atlas && npm run namefold && npm run ra && astro build && npm run autolink && npm run sitemap && npm run check:book && npm run check:living && npm run check:living2 && npm run check:families && npm run check:prose && npm run check:kin && npm run check:templates && npm run check:kit && npm run check:places && npm run check:evidence && npm run check:corrections && npm run check:retired && npm run check:worklist && npm run check:covers && npm run check:pages && npm run check:inline && npm run check:rows && npm run check:nav && npm run check:links && npm run check:rec && npm run check:standard && npm run check:era-ground && npm run check:era && npm run check:era:selftest",
    "build:pages": "npm run living:flags && npm run atlas && astro build && npm run sitemap",
    "preview": "astro preview --port 4324",
    "autolink": "python3 ../tools/namesindex.py --dist \"${ARCHIVE_OUT:-dist}\" --out .autolink && python3 node_modules/@daviddef/archive-kit/kit/tools/autolink.py --dist \"${ARCHIVE_OUT:-dist}\" --index .autolink/names-index.json --living .autolink/living.json --allow-prefix /people/ --allow-prefix /who/ --allow-prefix /search/",
    "check:links": "python3 ../tools/namesindex.py --dist \"${ARCHIVE_OUT:-dist}\" --out .autolink && python3 node_modules/@daviddef/archive-kit/kit/tools/checklinks.py --dist \"${ARCHIVE_OUT:-dist}\" --index .autolink/names-index.json --living .autolink/living.json --allow-prefix /people/ --allow-prefix /who/ --allow-prefix /search/ --floor .linkfloor.json",
    "sitemap": "python3 node_modules/@daviddef/archive-kit/kit/tools/sitemap.py --dist \"${ARCHIVE_OUT:-dist}\"",
    "check:book": "python3 node_modules/@daviddef/archive-kit/kit/tools/checkbook.py --dist \"${ARCHIVE_OUT:-dist}\" --book src/data/book.json",
    "check:kit": "python3 node_modules/@daviddef/archive-kit/kit/tools/checkarchive.py --dist \"${ARCHIVE_OUT:-dist}\"",
    "check:living": "python3 node_modules/@daviddef/archive-kit/kit/tools/checkliving.py --dist \"${ARCHIVE_OUT:-dist}\" --data src/data --policy named-bare --years --config standard.json --strict-allow",
    "living:flags": "python3 ../tools/livingflags.py",
    "check:living2": "python3 ../tools/checkliving2.py --dist \"${ARCHIVE_OUT:-dist}\" --data src/data",
    "check:families": "python3 ../tools/checkfamilies.py --dist \"${ARCHIVE_OUT:-dist}\" --data src/data",
    "check:prose": "python3 ../tools/check-prose.py",
    "check:prose-strict": "python3 ../tools/check-prose.py --require-tree",
    "check:worklist": "python3 node_modules/@daviddef/archive-kit/kit/tools/checkworklist.py --root .",
    "check:covers": "python3 node_modules/@daviddef/archive-kit/kit/tools/checkcovers.py --root .",
    "check:evidence": "python3 ../tools/checkevidence.py --dist \"${ARCHIVE_OUT:-dist}\" --data src/data",
    "check:corrections": "python3 ../tools/correctionswho.py --check",
    "check:places": "python3 node_modules/@daviddef/archive-kit/kit/tools/checkplaces.py --data public/atlas-data.json",
    "ra": "python3 node_modules/@daviddef/archive-kit/kit/tools/recordatlas.py --data public/atlas-data.json --gazetteer '../../The Geneology Map/site/src/data/places-full.json'",
    "check:templates": "python3 node_modules/@daviddef/archive-kit/kit/tools/checktemplates.py --root .",
    "namefold": "python3 node_modules/@daviddef/archive-kit/kit/tools/namefold.py --root . --all",
    "check:retired": "python3 node_modules/@daviddef/archive-kit/kit/tools/checkretired.py --root .",
    "check:pages": "python3 node_modules/@daviddef/archive-kit/kit/tools/checkpages.py --root . --estate ../.. --max-bespoke 0",
    "check:pin": "python3 node_modules/@daviddef/archive-kit/kit/tools/checkpin.py --root .",
    "check:nav": "python3 node_modules/@daviddef/archive-kit/kit/tools/checknav.py --dist \"${ARCHIVE_OUT:-dist}\" --strict",
    "check:inline": "python3 node_modules/@daviddef/archive-kit/kit/tools/checkinline.py --root . --max-inline 6",
    "check:rows": "python3 node_modules/@daviddef/archive-kit/kit/tools/checkrows.py --root .",
    "check:kin": "python3 node_modules/@daviddef/archive-kit/kit/tools/checkkin.py --data src/data/people.json --born b --died d --max 0 --name n",
    "check:decisions": "python3 ../tools/check-decisions.py",
    "check:letters": "python3 ../tools/checkletters.py",
    "check:dates": "python3 ../tools/checkdates.py",
    "check:readnames": "python3 ../tools/readnames.py --check",
    "check:rec": "python3 ../tools/check_rec.py --dist \"${ARCHIVE_OUT:-dist}\"",
    "check:era-ground": "python3 ../tools/build_era.py --check",
    "check:era": "python3 ../tools/build_era.py --living-urls ../private/era-living.json && python3 node_modules/@daviddef/archive-kit/kit/tools/checkera.py --dist \"${ARCHIVE_OUT:-dist}\" --snapshot src/data/era-snapshot.json --living-urls ../private/era-living.json --require-tracked",
    "check:era:selftest": "python3 node_modules/@daviddef/archive-kit/kit/tools/era_selftest.py",
    "check:standard": "python3 node_modules/@daviddef/archive-kit/kit/tools/checkstandard.py --dist \"${ARCHIVE_OUT:-dist}\" --index .autolink/names-index.json --config standard.json --living .autolink/living.json --floor .standardfloor.json --strict-config"
  },
  "dependencies": {
    "@daviddef/archive-kit": "github:daviddef/TheArchiveKit#341af3389cfb0d13ab0913bb065dc579b279c8cc",
    "astro": "^5.18.2"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@types/node": "^26.6.2",
    "typescript": "^5.9.3"
  }
}
