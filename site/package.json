{
  "name": "booyzen-archive",
  "type": "module",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "astro dev --port 4324",
    "atlas": "python3 ../tools/atlas.py",
    "build": "npm run atlas && astro build && npm run sitemap && npm run check:living && npm run check:kit && npm run check:evidence && npm run check:corrections && npm run check:worklist && npm run check:covers",
    "build:pages": "npm run atlas && astro build && npm run sitemap",
    "preview": "astro preview --port 4324",
    "sitemap": "python3 node_modules/@daviddef/archive-kit/kit/tools/sitemap.py",
    "check:kit": "python3 node_modules/@daviddef/archive-kit/kit/tools/checkarchive.py --dist dist",
    "check:living": "python3 node_modules/@daviddef/archive-kit/kit/tools/checkliving.py --dist dist --data src/data --policy named-bare",
    "check:worklist": "python3 node_modules/@daviddef/archive-kit/kit/tools/checkworklist.py --root .",
    "check:covers": "python3 node_modules/@daviddef/archive-kit/kit/tools/checkcovers.py --root .",
    "check:evidence": "python3 ../tools/checkevidence.py --dist dist --data src/data",
    "check:corrections": "python3 ../tools/correctionswho.py --check"
  },
  "dependencies": {
    "@daviddef/archive-kit": "github:daviddef/TheArchiveKit#e8dfc69cf16a290b2f9f0fa406da3f761b817a92",
    "astro": "^5.18.2"
  }
}